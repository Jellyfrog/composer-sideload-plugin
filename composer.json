{
    "name": "llava9/composer-sideload-plugin",
    "description": "Manage Composer packages in a separate composer-plugins.json file",
    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.6",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Composer\\Plugin\\SeparateFile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Composer\\Plugin\\SeparateFile\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "Composer\\Plugin\\SeparateFile\\SeparateFilePlugin"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
